# ==============================================================================
# ZYRO Voice Agent - Environment Configuration Template
# Copy this file to `.env` and fill in your Gemini API key.
# Real environment variables set in the OS always take precedence.
# ==============================================================================

# Google Gemini API Key (acquire from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Gemini Model (e.g. gemini-3.8-live, gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-3.8-live

# Safe Mock Mode:
# When true, all system-altering actions (launching apps, creating files, terminal)
# are simulated safely without making real system modifications.
ZYRO_MOCK_MODE=false

# Assistant Identity & Personality
ZYRO_NAME=ZYRO
ZYRO_PURPOSE=Windows-first personal AI assistant
ZYRO_DEVELOPER=Open Source Community
ZYRO_VERSION=1.0.0

# User Profile
ZYRO_USER_NAME=
ZYRO_USER_PREFERRED_NAME=

# Audio Hardware Overrides (optional -- empty string defaults to Windows system default)
ZYRO_DEFAULT_MIC=
ZYRO_DEFAULT_SPEAKER=
ZYRO_DEFAULT_CAMERA=

# Extra File Search Directories (comma-separated absolute paths)
# Default search covers Desktop, Documents, Downloads, Music, Pictures, Videos.
ZYRO_EXTRA_SEARCH_ROOTS=

# Logging Level (DEBUG, INFO, WARNING, ERROR)
ZYRO_LOG_LEVEL=INFO
